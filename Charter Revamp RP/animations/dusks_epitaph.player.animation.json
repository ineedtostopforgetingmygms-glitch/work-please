                    "rotation": [
                        "q.equipped_item_any_tag('slot.weapon.mainhand', 'weapon:dusks_epitaph') ? (query.main_hand_item_use_duration > 0 ? -90.0 + query.target_x_rotation - query.is_sneaking * 15.0 - this : -this - 50) : 0",
