{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.soulmould.behavior": {
			"initial_state": "dormant",
			"states": {
				"dormant": {
					"animations": ["dormant"],
					"transitions": [
						{"activate": "q.skin_id == 1"}
					]
				},
				"activate": {
					"animations": ["activate"],
					"transitions": [
						{"idle": "q.any_animation_finished"}
					]
				},
				"idle": {
					"animations": ["idle"],
					"transitions": [
						{"walking": "q.ground_speed > 1.0"},
						{"dormant": "q.delta_time > 1 && q.is_stunned"},
						{"attack": "v.attack_time"}
					],
					"blend_transition": 0.2
				},
				"walking": {
					"animations": ["walk"],
					"transitions": [
						{"idle": "q.ground_speed < 0.5"},
						{"attack": "v.attack_time"}
					],
					"blend_transition": 0.2
				},
				"attack": {
					"animations": ["attack"],
					"transitions": [
						{"walking": "q.any_animation_finished && q.ground_speed > 1.0"},
						{"idle": "q.any_animation_finished && q.ground_speed < 0.5"}
					]
				}
			}
		}
	}
}