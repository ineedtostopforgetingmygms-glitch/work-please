{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.bonefly.walk_behavior": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": ["idleGround"],
					"transitions": [
						{"idleFly": "q.property('bonefly:airborne')"},
						{"walking": "q.is_moving"},
						{"idleDormant": "q.is_sitting || q.property('bonefly:sit')"}
					],
					"blend_transition": 0.2
				},
				"idleFly": {
					"animations": ["idleFly"],
					"transitions": [
						{"default": "!q.property('bonefly:airborne')"}
					],
					"blend_transition": 0.2
				},
				"walking": {
					"animations": ["walkGround"],
					"transitions": [
						{"idleFly": "q.property('bonefly:airborne')"},
						{"default": "!q.is_moving"}
					],
					"blend_transition": 0.2
				},
				"idleDormant": {
					"animations": ["idleDormant"],
					"transitions": [
						{"idleFly": "q.property('bonefly:airborne')"},
						{"default": "!q.is_sitting && !q.property('bonefly:sit')"}
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.bonefly.behavior": {
			"states": {
				"default": {
					"animations": [],
					"transitions": [
						{"attack": "v.attack_time"},
						{"hurt": "q.hurt_time > 0.1"}
					],
					"blend_transition": 0.2
				},
				"attack": {
					"animations": [
						{"stab": "v.attack_time && q.is_moving"},
						{"stabIdle": "v.attack_time && !q.is_moving"}
					],
					"transitions": [
						{"default": "!v.attack_time"},
						{"hurt": "q.hurt_time > 0.1"}
					],
					"blend_transition": 0.2
				},
				"hurt": {
					"animations": ["hurt"],
					"transitions": [
						{"attack": "v.attack_time"},
						{"default": "q.hurt_time < 0.1"}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}