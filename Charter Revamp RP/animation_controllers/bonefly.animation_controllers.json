{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.bonefly.wing": {
			"initial_state": "idleGround",
			"states": {
				"idleGround": {
					"animations": ["idleGround"],
					"transitions": [
						{"dormant": "q.property('bonefly:dormant')"},
						{"idleFly": "q.property('bonefly:airborne')"},
						{"walkGround": "q.is_moving"}
					],
					"blend_transition": 0.2
				},
				"walkGround": {
					"animations": ["walkGround"],
					"transitions": [
						{"dormant": "q.property('bonefly:dormant')"},
						{"idleFly": "q.property('bonefly:airborne')"},
						{"idleGround": "!q.is_moving"}
					],
					"blend_transition": 0.2
				},
				"idleFly": {
					"animations": ["idleFly"],
					"transitions": [
						{"dormant": "q.property('bonefly:dormant')"},
						{"idleGround": "!q.property('bonefly:airborne')"}
					],
					"blend_transition": 0.2
				},
				"dormant": {
					"transitions": [
						{"idleGround": "!q.property('bonefly:dormant')"}
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.bonefly.idle": {
			"initial_state": "none",
			"states": {
				"none": {
					"transitions": [
						{"idleDormant": "q.property('bonefly:dormant')"},
						{"hurt": "q.hurt_time > 0"}
					],
					"blend_transition": 0.2
				},
				"idleDormant": {
					"animations": ["idleDormant"],
					"transitions": [
						{"none": "!q.property('bonefly:dormant')"}
					],
					"blend_transition": 0.2
				},
				"hurt": {
					"animations": ["hurt"],
					"transitions": [
						{"idleDormant": "q.property('bonefly:dormant')"},
						{"none": "q.hurt_time <= 0"}
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.bonefly.stab": {
			"initial_state": "none",
			"states": {
				"none": {
					"transitions": [
						{"stab": "q.property('bonefly:action_state') == 1"},
						{"stabIdle": "q.property('bonefly:action_state') == 2"}
					]
				},
				"stab": {
					"animations": ["stab"],
					"transitions": [
						{"stabIdle": "q.property('bonefly:action_state') == 2"},
						{"none": "q.property('bonefly:action_state') == 0"}
					]
				},
				"stabIdle": {
					"animations": ["stabIdle"],
					"transitions": [
						{"stab": "q.property('bonefly:action_state') == 1"},
						{"none": "q.property('bonefly:action_state') == 0"}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}
