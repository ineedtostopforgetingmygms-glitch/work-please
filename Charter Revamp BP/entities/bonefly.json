{
    "format_version": "1.21.110",
    "minecraft:entity": {
        "description": {
            "identifier": "charter:bonefly",
            "spawn_category": "creature",
            "is_spawnable": true,
            "is_summonable": true,
            // The state below is driven by scripts/Charter/entities/bonefly/bonefly.js.
            // Properties persist with the entity, so dormancy, the stab state and its
            // timer survive unloading, like the NBT fields of the original mod.
            "properties": {
                "bonefly:dormant": {
                    "type": "bool",
                    "client_sync": true,
                    "default": false
                },
                // 0 = normal, 1 = stabbing, 2 = stab finished (holding)
                "bonefly:action_state": {
                    "type": "int",
                    "range": [0, 2],
                    "client_sync": true,
                    "default": 0
                },
                "bonefly:stab_ticks": {
                    "type": "int",
                    "range": [0, 10],
                    "client_sync": false,
                    "default": 0
                },
                // true when there is no solid block within 2 blocks below it
                "bonefly:airborne": {
                    "type": "bool",
                    "client_sync": true,
                    "default": false
                },
                // which movement group is active: -1 = none yet, 0 = ground, 1 = air, 2 = dormant
                "bonefly:move_mode": {
                    "type": "int",
                    "range": [-1, 2],
                    "client_sync": false,
                    "default": -1
                },
                "bonefly:behavior": {
                    "type": "enum",
                    "values": [
                        "default",
                        "big",
                        "cute",
                        "grumpy",
                        "mad",
                        "puglin",
                        "sad"
                    ],
                    "default": "default",
                    "client_sync": true
                }
            }
        },
        "component_groups": {
            // ground mode: ordinary gravity-bound movement at the 0.32 movement speed
            "bonefly:ground": {
                "minecraft:physics": {
                    "has_gravity": true,
                    "has_collision": true
                },
                "minecraft:movement": {
                    "value": 0.32
                },
                // keeps the ground:air speed ratio of the original (0.32 : 0.40)
                "minecraft:flying_speed": {
                    "value": 0.0704
                }
            },
            // air mode: free flight without gravity at the faster flying speed
            "bonefly:air": {
                "minecraft:can_fly": {},
                "minecraft:physics": {
                    "has_gravity": false,
                    "has_collision": true
                },
                "minecraft:movement": {
                    "value": 0.32
                },
                "minecraft:flying_speed": {
                    "value": 0.088
                }
            },
            // dormant: frozen in place, even mid-air
            "bonefly:dormant": {
                "minecraft:physics": {
                    "has_gravity": false,
                    "has_collision": true
                },
                "minecraft:movement": {
                    "value": 0
                },
                "minecraft:flying_speed": {
                    "value": 0
                }
            },
            "bonefly:tamed": {
                "minecraft:is_tamed": {},
                // sneak + interact toggles dormancy; the script checks that it's the owner
                // and does the toggle (this just makes the interaction exist)
                "minecraft:interact": {
                    "interactions": [
                        {
                            "on_interact": {
                                "filters": {
                                    "test": "is_sneaking",
                                    "subject": "other",
                                    "value": true
                                },
                                "event": "bonefly:owner_interact",
                                "target": "self"
                            },
                            "interact_text": "action.interact.bonefly.dormant"
                        }
                    ]
                },
                "minecraft:rideable": {
                    "seat_count": 2,
                    "controlling_seat": 0,
                    "crouching_skip_interact": true,
                    "on_rider_enter_event": "bonefly:on_rider_enter",
                    "on_rider_exit_event": "bonefly:on_rider_exit",
                    // "mob" so the stab can carry creatures; they are only ever added by the script
                    "family_types": [
                        "player",
                        "mob"
                    ],
                    "interact_text": "action.interact.ride.bonefly",
                    "seats": [
                        {
                            "min_rider_count": 0,
                            "max_rider_count": 2,
                            "position": [0, 2.3, 0.6]
                        },
                        // whatever the stab picked up hangs under its body
                        {
                            "min_rider_count": 2,
                            "max_rider_count": 2,
                            "position": [0, 0.3, 0]
                        }
                    ]
                }
            },
            // rider controls: look to steer, WASD to move, jump to climb (like the vanilla happy ghast)
            "bonefly:ridden": {
                "minecraft:body_rotation_always_follows_head": {},
                "minecraft:behavior.player_ride_tamed": {
                    "priority": 1
                },
                "minecraft:free_camera_controlled": {
                    "strafe_speed_modifier": 1.0,
                    "backwards_movement_modifier": 0.5
                },
                "minecraft:vertical_movement_action": {
                    "vertical_velocity": 0.5
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "bonefly",
                    "monster",
                    "mob"
                ]
            },
            "minecraft:health": {
                "value": 60,
                "max": 60
            },
            "minecraft:attack": {
                "damage": 8
            },
            "minecraft:movement": {
                "value": 0.32
            },
            "minecraft:knockback_resistance": {
                "value": 1
            },
            "minecraft:follow_range": {
                "value": 24,
                "max": 24
            },
            "minecraft:collision_box": {
                "width": 1.8,
                "height": 2.5
            },
            // ownership is assigned by the script (hit it while carrying a Soultrap Effigy),
            // so there are no tame items
            "minecraft:tameable": {
                "probability": 1,
                "tame_event": {
                    "event": "minecraft:on_tame",
                    "target": "self"
                }
            },
            // it's a flyer: without this, dismounting mid-air drops it to its death
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "fall",
                    "deals_damage": "no"
                }
            },
            "minecraft:movement.hover": {},
            "minecraft:navigation.hover": {
                "can_path_over_water": true,
                "avoid_damage_blocks": true,
                "can_path_from_air": true,
                "avoid_water": true
            },
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:nameable": {},
            "minecraft:leashable_to": {},
            "minecraft:leashable": {
                "on_unleash": {
                    "event": "minecraft:on_unleashed",
                    "target": "self"
                },
                "presets": [
                    {
                        "hard_distance": 10,
                        "max_distance": 14
                    }
                ]
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:balloonable": {},
            "minecraft:breathable": {
                "total_supply": 5,
                "suffocate_time": 0,
                "breathes_air": true,
                "breathes_water": true
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "trigger": "bonefly:mode_ground"
            },
            "minecraft:on_tame": {
                "add": {
                    "component_groups": [
                        "bonefly:tamed"
                    ]
                }
            },
            "bonefly:owner_interact": {},
            "bonefly:on_rider_enter": {
                "add": {
                    "component_groups": [
                        "bonefly:ridden"
                    ]
                }
            },
            "bonefly:on_rider_exit": {
                "filters": {
                    "test": "rider_count",
                    "subject": "self",
                    "operator": "equals",
                    "value": 0
                },
                "remove": {
                    "component_groups": [
                        "bonefly:ridden"
                    ]
                }
            },
            "bonefly:mode_ground": {
                "remove": {
                    "component_groups": [
                        "bonefly:air",
                        "bonefly:dormant"
                    ]
                },
                "add": {
                    "component_groups": [
                        "bonefly:ground"
                    ]
                },
                "set_property": {
                    "bonefly:move_mode": 0
                }
            },
            "bonefly:mode_air": {
                "remove": {
                    "component_groups": [
                        "bonefly:ground",
                        "bonefly:dormant"
                    ]
                },
                "add": {
                    "component_groups": [
                        "bonefly:air"
                    ]
                },
                "set_property": {
                    "bonefly:move_mode": 1
                }
            },
            "bonefly:mode_dormant": {
                "remove": {
                    "component_groups": [
                        "bonefly:ground",
                        "bonefly:air"
                    ]
                },
                "add": {
                    "component_groups": [
                        "bonefly:dormant"
                    ]
                },
                "set_property": {
                    "bonefly:move_mode": 2
                }
            }
        }
    }
}